GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# AI provider configuration.
LLM_PROVIDER=gemini
# auto = Gemini embeddings when GEMINI_API_KEY is configured, deterministic local vectors otherwise.
EMBEDDING_PROVIDER=auto
RAG_LEXICAL_WEIGHT=0.45

# Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# Local fallback: sqlite:///./chatbot.db
DATABASE_URL=sqlite:///./chatbot.db

# Runtime environment. In production, insecure/default secrets are rejected at startup.
ENVIRONMENT=development

# JWT / dashboard auth. Bootstrap users are only created when these values are set.
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
AGENT_USERNAME=agent
AGENT_PASSWORD=change-me-now

# Signed browser chat sessions.
WEB_SESSION_SECRET=replace-with-a-separate-long-random-secret-at-least-32-characters
WEB_SESSION_MINUTES=1440
WEB_SESSION_REQUIRED=false

# Per-process public endpoint rate limiting. Put a shared edge limiter in front when scaling horizontally.
PUBLIC_RATE_LIMIT=60
PUBLIC_RATE_WINDOW_SECONDS=60

# Optional business integration webhooks
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
ORDER_STATUS_WEBHOOK_URL=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
