# OpenAI credentials must be supplied through the deployment environment/secret manager.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_TEMPERATURE=0.3
# Enable only for models/configurations that support temperature.
OPENAI_USE_TEMPERATURE=false

# AI provider configuration.
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=auto
RAG_LEXICAL_WEIGHT=0.45

DATABASE_URL=sqlite:///./chatbot.db
ENVIRONMENT=development

JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
AGENT_USERNAME=agent
AGENT_PASSWORD=change-me-now

# Browser chat session is stored in an HttpOnly SameSite=Strict cookie.
WEB_SESSION_SECRET=replace-with-a-separate-long-random-secret-at-least-32-characters
WEB_SESSION_MINUTES=1440
WEB_SESSION_REQUIRED=false
# Keep true in TLS deployments. Local HTTP development can override this to false.
WEB_SESSION_COOKIE_SECURE=true

# Distributed runtime. Configure Redis in multi-replica deployments.
REDIS_URL=
REDIS_REQUIRED=false
# Trust X-Forwarded-For only behind a proxy/load balancer that sanitizes this header.
TRUST_PROXY_HEADERS=false
PUBLIC_RATE_LIMIT=60
PUBLIC_RATE_WINDOW_SECONDS=60

# Webhook crash recovery and persistent outbound delivery.
WEBHOOK_PROCESSING_LEASE_SECONDS=300
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_PROCESSING_LEASE_SECONDS=60
OUTBOX_POLL_SECONDS=2
OUTBOX_BATCH_SIZE=50

CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
ORDER_STATUS_WEBHOOK_URL=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
