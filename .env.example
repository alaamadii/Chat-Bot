GEMINI_API_KEY=

# Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# Local fallback: sqlite:///./chatbot.db
DATABASE_URL=sqlite:///./chatbot.db

# JWT / dashboard auth. Bootstrap users are only created when these values are set.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
AGENT_USERNAME=agent
AGENT_PASSWORD=change-me-now

# Optional business integration webhooks
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
ORDER_STATUS_WEBHOOK_URL=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
